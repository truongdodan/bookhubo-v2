@model BookHubo.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-5">
    <h4 class="mb-2 fw-normal">Admin Dashboard</h4>
    <p class="text-muted small">Tổng quan hệ thống</p>
</div>

<div class="row g-3 mb-5">
    <div class="col-md-3">
        <div class="card border">
            <div class="card-body text-center py-4">
                <h4 class="mb-0 fw-bold">@Model.TotalUsers</h4>
                <p class="text-muted mb-0 small">Người dùng</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border">
            <div class="card-body text-center py-4">
                <h4 class="mb-0 fw-bold">@Model.TotalActiveListings</h4>
                <p class="text-muted mb-0 small">Sách đang bán</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border">
            <div class="card-body text-center py-4">
                <h4 class="mb-0 fw-bold">@Model.TotalOrders</h4>
                <p class="text-muted mb-0 small">Đơn hàng</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border">
            <div class="card-body text-center py-4">
                <h4 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("N0") đ</h4>
                <p class="text-muted mb-0 small">Doanh thu</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100 border">
            <div class="card-body p-4 d-flex flex-column">
                <h6 class="card-title mb-2 fw-normal">Quản lý người dùng</h6>
                <p class="card-text text-muted mb-3 small">Xem và quản lý người dùng</p>
                <a asp-action="Users" class="btn btn-outline-dark btn-sm mt-auto">
                    Quản lý →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border">
            <div class="card-body p-4 d-flex flex-column">
                <h6 class="card-title mb-2 fw-normal">Quản lý sách</h6>
                <p class="card-text text-muted mb-3 small">Xem và quản lý sách đang bán</p>
                <a asp-action="Listings" class="btn btn-outline-dark btn-sm mt-auto">
                    Quản lý →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border">
            <div class="card-body p-4 d-flex flex-column">
                <h6 class="card-title mb-2 fw-normal">Quản lý đơn hàng</h6>
                <p class="card-text text-muted mb-3 small">Xem và quản lý đơn hàng</p>
                <a asp-action="Orders" class="btn btn-outline-dark btn-sm mt-auto">
                    Quản lý →
                </a>
            </div>
        </div>
    </div>
</div>
