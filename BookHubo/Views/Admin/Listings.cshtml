@model List<BookHubo.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
    </a>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="bi bi-book"></i> Quản lý sách</h4>
    </div>
    <div class="card-body">
        <!-- Search and Filter Form -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Tìm kiếm</label>
                <input type="text" name="search" class="form-control" placeholder="Tiêu đề hoặc tác giả..." value="@ViewBag.SearchQuery">
            </div>
            <div class="col-md-3">
                <label class="form-label">Thể loại</label>
                <select name="category" class="form-select">
                    <option value="">Tất cả thể loại</option>
                    <option value="Tiểu thuyết" selected="@(ViewBag.CategoryFilter == "Tiểu thuyết")">Tiểu thuyết</option>
                    <option value="Viễn tưởng" selected="@(ViewBag.CategoryFilter == "Viễn tưởng")">Viễn tưởng</option>
                    <option value="Giáo khoa" selected="@(ViewBag.CategoryFilter == "Giáo khoa")">Giáo khoa</option>
                    <option value="Khác" selected="@(ViewBag.CategoryFilter == "Khác")">Khác</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Đang bán</option>
                    <option value="Deleted" selected="@(ViewBag.StatusFilter == "Deleted")">Đã xóa</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Tìm
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tiêu đề</th>
                        <th>Người bán</th>
                        <th>Giá</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr id="listing-row-@book.BookId">
                            <td>@book.BookId</td>
                            <td>
                                <strong>@book.Title</strong><br>
                                <small class="text-muted">@book.Author</small>
                            </td>
                            <td>@book.Seller?.FullName</td>
                            <td>@book.Price.ToString("N0") VNĐ</td>
                            <td>
                                @if (book.IsActive)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã xóa</span>
                                }
                            </td>
                            <td>@book.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (book.IsActive)
                                {
                                    <button class="btn btn-sm btn-danger" onclick="deleteListing(@book.BookId, '@book.Title')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Đã xóa</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Không có sách nào
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}
