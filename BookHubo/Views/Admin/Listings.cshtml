@model List<BookHubo.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
    </a>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="bi bi-book"></i> Quản lý sách</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tiêu đề</th>
                        <th>Người bán</th>
                        <th>Giá</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr id="listing-row-@book.BookId">
                            <td>@book.BookId</td>
                            <td>
                                <strong>@book.Title</strong><br>
                                <small class="text-muted">@book.Author</small>
                            </td>
                            <td>@book.Seller?.FullName</td>
                            <td>@book.Price.ToString("N0") VNĐ</td>
                            <td>
                                @if (book.IsActive)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã xóa</span>
                                }
                            </td>
                            <td>@book.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (book.IsActive)
                                {
                                    <button class="btn btn-sm btn-danger" onclick="deleteListing(@book.BookId, '@book.Title')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Đã xóa</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Không có sách nào
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}
