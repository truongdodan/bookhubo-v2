@model List<BookHubo.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-light border">
        ← Dashboard
    </a>
</div>

<div class="card border">
    <div class="card-header bg-white border-bottom">
        <h5 class="mb-0 fw-normal">Quản lý sách</h5>
    </div>
    <div class="card-body p-4">
        <!-- Search and Filter Form -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label small">Tìm kiếm</label>
                <input type="text" name="search" class="form-control" placeholder="Tiêu đề hoặc tác giả..." value="@ViewBag.SearchQuery">
            </div>
            <div class="col-md-3">
                <label class="form-label small">Thể loại</label>
                <select name="category" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Tiểu thuyết" selected="@(ViewBag.CategoryFilter == "Tiểu thuyết")">Tiểu thuyết</option>
                    <option value="Viễn tưởng" selected="@(ViewBag.CategoryFilter == "Viễn tưởng")">Viễn tưởng</option>
                    <option value="Giáo khoa" selected="@(ViewBag.CategoryFilter == "Giáo khoa")">Giáo khoa</option>
                    <option value="Khác" selected="@(ViewBag.CategoryFilter == "Khác")">Khác</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Đang bán</option>
                    <option value="Deleted" selected="@(ViewBag.StatusFilter == "Deleted")">Đã xóa</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100">
                    Tìm
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="border-bottom">
                    <tr>
                        <th class="border-0 fw-normal"><small>ID</small></th>
                        <th class="border-0 fw-normal"><small>Tiêu đề</small></th>
                        <th class="border-0 fw-normal"><small>Người bán</small></th>
                        <th class="border-0 fw-normal"><small>Giá</small></th>
                        <th class="border-0 fw-normal"><small>Trạng thái</small></th>
                        <th class="border-0 fw-normal"><small>Ngày tạo</small></th>
                        <th class="text-center border-0 fw-normal"><small>Hành động</small></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr id="listing-row-@book.BookId">
                            <td>@book.BookId</td>
                            <td>
                                <strong class="fw-normal">@book.Title</strong><br>
                                <small class="text-muted">@book.Author</small>
                            </td>
                            <td><small>@book.Seller?.FullName</small></td>
                            <td>@book.Price.ToString("N0") đ</td>
                            <td>
                                @if (book.IsActive)
                                {
                                    <span class="badge bg-light text-dark border">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">Đã xóa</span>
                                }
                            </td>
                            <td><small>@book.CreatedAt.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-center">
                                @if (book.IsActive)
                                {
                                    <button class="btn btn-sm btn-light border" onclick="deleteListing(@book.BookId, '@book.Title')">
                                        Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted"><small>Đã xóa</small></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-muted text-center py-4">
                <small>Không có sách nào</small>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}
