@model List<BookHubo.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
    </a>
</div>

<div class="card">
    <div class="card-header bg-warning text-white">
        <h4 class="mb-0"><i class="bi bi-cart"></i> Quản lý đơn hàng</h4>
    </div>
    <div class="card-body">
        <!-- Search and Filter Form -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Tìm kiếm</label>
                <input type="text" name="search" class="form-control" placeholder="Mã đơn hàng, tên hoặc email người mua..." value="@ViewBag.SearchQuery">
            </div>
            <div class="col-md-4">
                <label class="form-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Chờ xử lý</option>
                    <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Hoàn thành</option>
                    <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Tìm
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Người mua</th>
                        <th>Số sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.OrderId</strong></td>
                            <td>
                                @order.Buyer?.FullName<br>
                                <small class="text-muted">@order.Buyer?.Email</small>
                            </td>
                            <td>@order.OrderItems?.Count sản phẩm</td>
                            <td><strong>@order.TotalPrice.ToString("N0") VNĐ</strong></td>
                            <td>
                                @{
                                    var allCompleted = order.OrderItems?.All(oi => oi.Status == "Completed") ?? false;
                                    var anyPending = order.OrderItems?.Any(oi => oi.Status == "Pending") ?? false;
                                    var anyCancelled = order.OrderItems?.Any(oi => oi.Status == "Cancelled") ?? false;
                                }
                                @if (allCompleted)
                                {
                                    <span class="badge bg-success">Hoàn thành</span>
                                }
                                else if (anyPending)
                                {
                                    <span class="badge bg-warning">Chờ xử lý</span>
                                }
                                else if (anyCancelled)
                                {
                                    <span class="badge bg-danger">Có đơn bị hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã xử lý</span>
                                }
                            </td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Không có đơn hàng nào
            </div>
        }
    </div>
</div>
