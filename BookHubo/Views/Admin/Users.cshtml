@model List<BookHubo.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-light border">
        ← Dashboard
    </a>
</div>

<div class="card border">
    <div class="card-header bg-white border-bottom">
        <h5 class="mb-0 fw-normal">Quản lý người dùng</h5>
    </div>
    <div class="card-body p-4">
        <!-- Search and Filter Form -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label small">Tìm kiếm</label>
                <input type="text" name="search" class="form-control" placeholder="Email hoặc tên..." value="@ViewBag.SearchQuery">
            </div>
            <div class="col-md-4">
                <label class="form-label small">Vai trò</label>
                <select name="role" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="User" selected="@(ViewBag.RoleFilter == "User")">User</option>
                    <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin")">Admin</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100">
                    Tìm
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="border-bottom">
                    <tr>
                        <th class="border-0 fw-normal"><small>ID</small></th>
                        <th class="border-0 fw-normal"><small>Email</small></th>
                        <th class="border-0 fw-normal"><small>Họ tên</small></th>
                        <th class="border-0 fw-normal"><small>Vai trò</small></th>
                        <th class="border-0 fw-normal"><small>Trạng thái</small></th>
                        <th class="border-0 fw-normal"><small>Ngày tạo</small></th>
                        <th class="text-center border-0 fw-normal"><small>Hành động</small></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr id="user-row-@user.UserId">
                            <td>@user.UserId</td>
                            <td><small>@user.Email</small></td>
                            <td><small>@user.FullName</small></td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-dark">@user.Role</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@user.Role</span>
                                }
                            </td>
                            <td id="user-status-@user.UserId">
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-dark">Bị cấm</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Hoạt động</span>
                                }
                            </td>
                            <td><small>@user.CreatedAt.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-center" id="user-actions-@user.UserId">
                                @if (user.Role != "Admin")
                                {
                                    @if (user.IsBanned)
                                    {
                                        <button class="btn btn-sm btn-light border" onclick="unbanUser(@user.UserId, '@user.Email')">
                                            Gỡ cấm
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light border" onclick="banUser(@user.UserId, '@user.Email')">
                                            Cấm
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-light border" onclick="deleteUser(@user.UserId, '@user.Email')">
                                        Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted"><small>Admin</small></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-muted text-center py-4">
                <small>Không có người dùng nào</small>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}
