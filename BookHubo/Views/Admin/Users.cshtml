@model List<BookHubo.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
    </a>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-people"></i> Quản lý người dùng</h4>
    </div>
    <div class="card-body">
        <!-- Search and Filter Form -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Tìm kiếm</label>
                <input type="text" name="search" class="form-control" placeholder="Email hoặc tên người dùng..." value="@ViewBag.SearchQuery">
            </div>
            <div class="col-md-4">
                <label class="form-label">Vai trò</label>
                <select name="role" class="form-select">
                    <option value="">Tất cả vai trò</option>
                    <option value="User" selected="@(ViewBag.RoleFilter == "User")">User</option>
                    <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin")">Admin</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Tìm
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Họ tên</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr id="user-row-@user.UserId">
                            <td>@user.UserId</td>
                            <td>@user.Email</td>
                            <td>@user.FullName</td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger">@user.Role</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@user.Role</span>
                                }
                            </td>
                            <td id="user-status-@user.UserId">
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-dark">Bị cấm</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center" id="user-actions-@user.UserId">
                                @if (user.Role != "Admin")
                                {
                                    @if (user.IsBanned)
                                    {
                                        <button class="btn btn-sm btn-success" onclick="unbanUser(@user.UserId, '@user.Email')">
                                            <i class="bi bi-check-circle"></i> Gỡ cấm
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-warning" onclick="banUser(@user.UserId, '@user.Email')">
                                            <i class="bi bi-ban"></i> Cấm
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-danger" onclick="deleteUser(@user.UserId, '@user.Email')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Admin</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Không có người dùng nào
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>
}
