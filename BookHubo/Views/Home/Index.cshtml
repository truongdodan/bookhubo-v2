@model IEnumerable<BookHubo.Models.Book>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center py-5 mb-5">
    <h1 class="display-5 fw-normal mb-3">BookHubo</h1>
    <p class="text-muted mb-4">Mua bán sách đã qua sử dụng</p>

    <form asp-controller="Books" asp-action="Search" method="get">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="input-group">
                    <input type="text" name="keyword" class="form-control border-0 bg-light" placeholder="Tìm sách theo tên hoặc tác giả..." style="padding: 0.75rem;">
                    <button class="btn btn-dark px-4" type="submit">
                        Tìm kiếm
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="mb-5">
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a asp-controller="Books" asp-action="Category" asp-route-category="Fiction" class="btn btn-light border text-dark">
            Tiểu thuyết
        </a>
        <a asp-controller="Books" asp-action="Category" asp-route-category="Science Fiction" class="btn btn-light border text-dark">
            Viễn tưởng
        </a>
        <a asp-controller="Books" asp-action="Category" asp-route-category="Textbook" class="btn btn-light border text-dark">
            Sách giáo khoa
        </a>
        <a asp-controller="Books" asp-action="Category" asp-route-category="Comics" class="btn btn-light border text-dark">
            Truyện tranh
        </a>
        <a asp-controller="Books" asp-action="Category" asp-route-category="Children" class="btn btn-light border text-dark">
            Sách thiếu nhi
        </a>
        <a asp-controller="Books" asp-action="Category" asp-route-category="Science" class="btn btn-light border text-dark">
            Khoa học
        </a>
        <a asp-controller="Books" asp-action="Search" class="btn btn-light border text-dark">
            Tìm kiếm nâng cao
        </a>
    </div>
</div>

<div class="mb-4">
    <h5 class="fw-normal text-muted">Sách mới nhất</h5>
</div>

@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3 mb-5">
        @foreach (var book in Model)
        {
            <div class="col">
                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none text-dark">
                    <div class="card h-100 border" style="cursor: pointer; transition: box-shadow 0.2s;">
                        @if (!string.IsNullOrEmpty(book.ImagePath))
                        {
                            <img src="@book.ImagePath" class="card-img-top" alt="@book.Title" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                <i class="bi bi-book text-secondary" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title mb-1 fw-normal">@book.Title</h6>
                            <p class="card-text mb-2">
                                <small class="text-muted">@book.Author</small>
                            </p>
                            @if (book.TotalReviews > 0)
                            {
                                <p class="mb-2">
                                    <small>
                                        <span class="text-warning">★ @book.AverageRating.ToString("0.0")</span>
                                        <span class="text-muted">(@book.TotalReviews)</span>
                                    </small>
                                </p>
                            }
                            <p class="fw-bold mb-0 mt-auto">@book.Price.ToString("N0") đ</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        <p class="mt-3 text-muted">Chưa có sách nào được đăng bán</p>
    </div>
}
