@model BookHubo.Controllers.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2 class="mb-4">Giỏ hàng của bạn</h2>

@if (Model.SellerGroups.Any())
{
    @foreach (var group in Model.SellerGroups)
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Người bán: @group.SellerName</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Ảnh</th>
                                <th>Sách</th>
                                <th style="width: 150px;">Giá</th>
                                <th style="width: 120px;">Số lượng</th>
                                <th style="width: 150px;">Tạm tính</th>
                                <th style="width: 100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group.Items)
                            {
                                <tr data-cart-item-id="@item.CartItemId">
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Book.ImagePath))
                                        {
                                            <img src="@item.Book.ImagePath" alt="@item.Book.Title" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="bi bi-book"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.Book.Title</strong><br>
                                        <small class="text-muted">@item.Book.Author</small>
                                    </td>
                                    <td>@item.Book.Price.ToString("N0") VNĐ</td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <button class="btn btn-outline-secondary btn-decrease" type="button" data-cart-item-id="@item.CartItemId">-</button>
                                            <input type="number" class="form-control text-center quantity-input" value="@item.Quantity" min="1" max="@item.Book.StockQuantity" data-cart-item-id="@item.CartItemId" readonly>
                                            <button class="btn btn-outline-secondary btn-increase" type="button" data-cart-item-id="@item.CartItemId" data-max-stock="@item.Book.StockQuantity">+</button>
                                        </div>
                                    </td>
                                    <td class="subtotal">@((item.Book.Price * item.Quantity).ToString("N0")) VNĐ</td>
                                    <td>
                                        <button class="btn btn-sm btn-danger btn-remove" data-cart-item-id="@item.CartItemId">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-end">
                    <h5>Tổng phụ: <span class="text-success">@group.Subtotal.ToString("N0") VNĐ</span></h5>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h4 class="mb-0">Tổng cộng: <span class="text-success" id="grandTotal">@Model.GrandTotal.ToString("N0") VNĐ</span></h4>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-credit-card"></i> Tiến hành thanh toán
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
        <p class="mt-3">Giỏ hàng của bạn đang trống</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Tiếp tục mua sắm</a>
    </div>
}

@section Scripts {
    <script src="~/js/cart.js"></script>
}
