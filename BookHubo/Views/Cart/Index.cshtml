@model BookHubo.Controllers.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h4 class="mb-4 fw-normal">Giỏ hàng</h4>

@if (Model.SellerGroups.Any())
{
    @foreach (var group in Model.SellerGroups)
    {
        <div class="card mb-4 border">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0 fw-normal">Người bán: @group.SellerName</h6>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="border-bottom">
                            <tr>
                                <th style="width: 80px;" class="border-0 fw-normal"><small>Ảnh</small></th>
                                <th class="border-0 fw-normal"><small>Sách</small></th>
                                <th style="width: 150px;" class="border-0 fw-normal"><small>Giá</small></th>
                                <th style="width: 120px;" class="border-0 fw-normal"><small>Số lượng</small></th>
                                <th style="width: 150px;" class="border-0 fw-normal"><small>Tạm tính</small></th>
                                <th style="width: 100px;" class="border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group.Items)
                            {
                                <tr data-cart-item-id="@item.CartItemId">
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Book.ImagePath))
                                        {
                                            <img src="@item.Book.ImagePath" alt="@item.Book.Title" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="bi bi-book"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong class="fw-normal">@item.Book.Title</strong><br>
                                        <small class="text-muted">@item.Book.Author</small>
                                    </td>
                                    <td>@item.Book.Price.ToString("N0") đ</td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <button class="btn btn-outline-secondary btn-decrease" type="button" data-cart-item-id="@item.CartItemId">-</button>
                                            <input type="number" class="form-control text-center quantity-input" value="@item.Quantity" min="1" max="@item.Book.StockQuantity" data-cart-item-id="@item.CartItemId" readonly>
                                            <button class="btn btn-outline-secondary btn-increase" type="button" data-cart-item-id="@item.CartItemId" data-max-stock="@item.Book.StockQuantity">+</button>
                                        </div>
                                    </td>
                                    <td class="subtotal">@((item.Book.Price * item.Quantity).ToString("N0")) đ</td>
                                    <td>
                                        <button class="btn btn-sm btn-light border btn-remove" data-cart-item-id="@item.CartItemId">
                                            Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-end mt-3">
                    <h6 class="mb-0 fw-normal">Tổng phụ: <span class="fw-bold">@group.Subtotal.ToString("N0") đ</span></h6>
                </div>
            </div>
        </div>
    }

    <div class="card border">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-md-0 mb-3 fw-normal">Tổng cộng: <span class="fw-bold" id="grandTotal">@Model.GrandTotal.ToString("N0") đ</span></h5>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-dark px-4">
                        Thanh toán
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
        <p class="mt-3 text-muted">Giỏ hàng của bạn đang trống</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark mt-2">
            Tiếp tục mua sắm
        </a>
    </div>
}

@section Scripts {
    <script src="~/js/cart.js"></script>
}
