@model BookHubo.Controllers.SellerProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ người bán";
}

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h2>@Model.Seller.FullName</h2>
                        <div class="mb-2">
                            @if (Model.Seller.TotalReviews > 0)
                            {
                                <span class="text-warning fs-4">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= (double)Model.Seller.AverageRating)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">☆</span>
                                        }
                                    }
                                </span>
                                <span class="ms-2">
                                    <strong>@Model.Seller.AverageRating.ToString("0.00")</strong> từ @Model.Seller.TotalReviews đánh giá
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa có đánh giá nào</span>
                            }
                        </div>
                        <p class="text-muted mb-0">
                            <i class="bi bi-envelope"></i> @Model.Seller.Email
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="books-tab" data-bs-toggle="tab" data-bs-target="#books" type="button" role="tab">
                    <i class="bi bi-book"></i> Sách đang bán (@Model.Books.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                    <i class="bi bi-star"></i> Đánh giá (@Model.Reviews.Count)
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="books" role="tabpanel">
                @if (Model.Books.Any())
                {
                    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                        @foreach (var book in Model.Books)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm">
                                    @if (!string.IsNullOrEmpty(book.ImagePath))
                                    {
                                        <img src="@book.ImagePath" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                            <i class="bi bi-book text-muted" style="font-size: 3rem;"></i>
                                        </div>
                                    }
                                    <div class="card-body">
                                        <h6 class="card-title">@book.Title</h6>
                                        <p class="card-text">
                                            <small class="text-muted">@book.Author</small><br>
                                            <span class="text-success fw-bold">@book.Price.ToString("N0") VNĐ</span>
                                        </p>
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-primary w-100">
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-inbox"></i> Người bán chưa có sách nào đang bán
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="reviews" role="tabpanel">
                @if (Model.Reviews.Any())
                {
                    <div class="row" id="seller-reviews-container">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="col-12 mb-3">
                                <partial name="_ReviewCard" model="review" view-data='@new ViewDataDictionary(ViewData) { { "ShowBookTitle", true } }' />
                            </div>
                        }
                    </div>

                    @if (Model.HasMoreReviews)
                    {
                        <div class="text-center mt-3">
                            <button id="load-more-seller-reviews-btn" class="btn btn-outline-primary" onclick="loadMoreSellerReviews()">
                                <i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-chat-left-text"></i> Chưa có đánh giá nào
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSellerSkip = 5;
        const sellerId = @Model.Seller.UserId;

        async function loadMoreSellerReviews() {
            const btn = document.getElementById('load-more-seller-reviews-btn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tải...';

            try {
                const response = await fetch(`/Seller/LoadMoreReviews?sellerId=${sellerId}&skip=${currentSellerSkip}&take=5`);
                const reviews = await response.json();

                if (reviews.length > 0) {
                    const container = document.getElementById('seller-reviews-container');

                    reviews.forEach(review => {
                        const reviewHtml = `
                            <div class="col-12 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1">${review.buyerName}</h6>
                                                <small class="text-muted">${review.createdAt}</small>
                                            </div>
                                            <div class="text-warning fs-5">
                                                ${generateStars(review.rating)}
                                            </div>
                                        </div>
                                        <p class="mb-2">
                                            <small class="text-muted">
                                                <i class="bi bi-book"></i> Mua sách: <strong>${review.bookTitle}</strong>
                                            </small>
                                        </p>
                                        ${review.comment ?
                                            `<p class="mb-0">${review.comment}</p>` :
                                            '<p class="mb-0 text-muted fst-italic">Người mua không để lại nhận xét</p>'
                                        }
                                    </div>
                                </div>
                            </div>
                        `;
                        container.insertAdjacentHTML('beforeend', reviewHtml);
                    });

                    currentSellerSkip += reviews.length;

                    if (currentSellerSkip >= @Model.Seller.TotalReviews) {
                        btn.remove();
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá';
                    }
                } else {
                    btn.remove();
                }
            } catch (error) {
                console.error('Error loading reviews:', error);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá';
                alert('Có lỗi xảy ra khi tải đánh giá');
            }
        }

        function generateStars(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= rating) {
                    stars += '<span>★</span>';
                } else {
                    stars += '<span class="text-muted">☆</span>';
                }
            }
            return stars;
        }
    </script>
}

