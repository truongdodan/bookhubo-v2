@model IEnumerable<BookHubo.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<h4 class="mb-4 fw-normal">Đơn hàng của tôi</h4>

@if (Model.Any())
{
    <div class="row">
        @foreach (var order in Model)
        {
            <div class="col-12 mb-3">
                <div class="card border">
                    <div class="card-header bg-white border-bottom">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h6 class="mb-0 fw-normal">
                                    Đơn hàng #@order.OrderId
                                </h6>
                                <small class="text-muted">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <h6 class="mb-0 fw-bold">@order.TotalPrice.ToString("N0") đ</h6>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="border-bottom">
                                    <tr>
                                        <th class="border-0 fw-normal"><small>Sách</small></th>
                                        <th class="border-0 fw-normal"><small>Người bán</small></th>
                                        <th class="text-center border-0 fw-normal"><small>SL</small></th>
                                        <th class="text-end border-0 fw-normal"><small>Giá</small></th>
                                        <th class="text-center border-0 fw-normal"><small>Trạng thái</small></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="fw-normal">@item.Book.Title</strong><br>
                                                <small class="text-muted">@item.Book.Author</small>
                                            </td>
                                            <td>@item.Seller?.FullName</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@((item.PriceAtPurchase * item.Quantity).ToString("N0")) đ</td>
                                            <td class="text-center">
                                                @if (item.Status == "Pending")
                                                {
                                                    <span class="badge bg-light text-dark border">Chờ xử lý</span>
                                                }
                                                else if (item.Status == "Shipped")
                                                {
                                                    <span class="badge bg-light text-dark border">Đã giao</span>
                                                }
                                                else if (item.Status == "Completed")
                                                {
                                                    <span class="badge bg-light text-dark border">Hoàn thành</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3 pt-3 border-top">
                            <p class="mb-1 text-muted"><small><strong class="fw-normal">Địa chỉ giao hàng:</strong> @order.ShippingAddress</small></p>
                        </div>
                        <div class="text-end mt-2">
                            <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-dark">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        <p class="mt-3 text-muted">Bạn chưa có đơn hàng nào</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark mt-2">
            Tiếp tục mua sắm
        </a>
    </div>
}
