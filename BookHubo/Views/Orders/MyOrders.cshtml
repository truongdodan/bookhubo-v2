@model IEnumerable<BookHubo.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<h2 class="mb-4">Đơn hàng của tôi</h2>

@if (Model.Any())
{
    <div class="row">
        @foreach (var order in Model)
        {
            <div class="col-12 mb-3">
                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h5 class="mb-0">
                                    <i class="bi bi-receipt"></i> Đơn hàng #@order.OrderId
                                </h5>
                                <small class="text-muted">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <h5 class="text-success mb-0">@order.TotalPrice.ToString("N0") VNĐ</h5>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Sách</th>
                                        <th>Người bán</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Giá</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.Book.Title</strong><br>
                                                <small class="text-muted">@item.Book.Author</small>
                                            </td>
                                            <td>@item.Seller?.FullName</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@((item.PriceAtPurchase * item.Quantity).ToString("N0")) VNĐ</td>
                                            <td class="text-center">
                                                @if (item.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning">Chờ xử lý</span>
                                                }
                                                else if (item.Status == "Shipped")
                                                {
                                                    <span class="badge bg-info">Đã giao</span>
                                                }
                                                else if (item.Status == "Completed")
                                                {
                                                    <span class="badge bg-success">Hoàn thành</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <p class="mb-1"><strong>Địa chỉ giao hàng:</strong> @order.ShippingAddress</p>
                        </div>
                        <div class="text-end mt-2">
                            <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary">
                                <i class="bi bi-eye"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
        <p class="mt-3">Bạn chưa có đơn hàng nào</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-shop"></i> Tiếp tục mua sắm
        </a>
    </div>
}
