@model BookHubo.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="mb-3">
    <a asp-action="MyOrders" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            <i class="bi bi-receipt"></i> Đơn hàng #@Model.OrderId
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-muted">Thông tin đơn hàng</h6>
                <p class="mb-1"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-success">@Model.TotalPrice.ToString("N0") VNĐ</span></p>
            </div>
            <div class="col-md-6">
                <h6 class="text-muted">Thông tin giao hàng</h6>
                <p class="mb-1"><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
            </div>
        </div>

        <hr>

        <h5 class="mb-3">Chi tiết sản phẩm</h5>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Sách</th>
                        <th>Người bán</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.Book.ImagePath))
                                    {
                                        <img src="@item.Book.ImagePath" alt="@item.Book.Title" class="me-2" style="width: 50px; height: 50px; object-fit: cover;">
                                    }
                                    <div>
                                        <strong>@item.Book.Title</strong><br>
                                        <small class="text-muted">@item.Book.Author</small>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Seller?.FullName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.PriceAtPurchase.ToString("N0") VNĐ</td>
                            <td class="text-end">@((item.PriceAtPurchase * item.Quantity).ToString("N0")) VNĐ</td>
                            <td class="text-center">
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning">Chờ xử lý</span>
                                    @if (item.ShippedAt != null)
                                    {
                                        <br><small class="text-muted">Giao: @item.ShippedAt.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                }
                                else if (item.Status == "Shipped")
                                {
                                    <span class="badge bg-info">Đã giao</span>
                                    @if (item.ShippedAt != null)
                                    {
                                        <br><small class="text-muted">Giao: @item.ShippedAt.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Hoàn thành</span>
                                    @if (item.CompletedAt != null)
                                    {
                                        <br><small class="text-muted">Hoàn thành: @item.CompletedAt.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Shipped")
                                {
                                    <button class="btn btn-sm btn-success" onclick="markAsCompleted(@item.OrderItemId)">
                                        <i class="bi bi-check-circle"></i> Đã nhận hàng
                                    </button>
                                }
                                @if (item.Status == "Completed")
                                {
                                    <a href="#" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-star"></i> Đánh giá
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function markAsCompleted(orderItemId) {
            if (!confirm('Xác nhận đã nhận hàng?')) {
                return;
            }

            try {
                const response = await fetch(`/api/Orders/MarkCompleted/${orderItemId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra');
                }
            } catch (error) {
                alert('Có lỗi xảy ra khi xử lý yêu cầu');
                console.error(error);
            }
        }
    </script>
}
