@model BookHubo.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="text-center mb-5">
    <i class="bi bi-check-circle text-success" style="font-size: 5rem;"></i>
    <h2 class="mt-3">Đặt hàng thành công!</h2>
    <p class="text-muted">Cảm ơn bạn đã mua hàng tại BookHubo</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Thông tin đơn hàng</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Mã đơn hàng:</strong> #@Model.OrderId</p>
                        <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Tổng tiền:</strong> <span class="text-success">@Model.TotalPrice.ToString("N0") VNĐ</span></p>
                        <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
                    </div>
                </div>

                <hr>

                <h6 class="mb-3">Chi tiết sản phẩm:</h6>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Sách</th>
                                <th>Người bán</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Book.Title</strong><br>
                                        <small class="text-muted">@item.Book.Author</small>
                                    </td>
                                    <td>@item.Seller?.FullName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.PriceAtPurchase.ToString("N0") VNĐ</td>
                                    <td class="text-end">@((item.PriceAtPurchase * item.Quantity).ToString("N0")) VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <strong>Lưu ý:</strong> Bạn có thể theo dõi đơn hàng của mình tại trang "Đơn hàng của tôi".
            Người bán sẽ xác nhận và giao hàng trong thời gian sớm nhất.
        </div>

        <div class="text-center">
            <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-primary">
                <i class="bi bi-list-ul"></i> Xem đơn hàng của tôi
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
