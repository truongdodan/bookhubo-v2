@model IEnumerable<BookHubo.Models.OrderItem>
@{
    ViewData["Title"] = "Quản lý bán hàng";
}

<div class="row">
    <div class="col-md-12">
        <h4 class="mb-4 fw-normal">Quản lý bán hàng</h4>

        <!-- Filter by Status -->
        <div class="btn-group mb-4" role="group">
            <a asp-action="Index" asp-route-status="all" class="btn btn-light border @(ViewBag.CurrentStatus == "all" ? "active" : "")">
                Tất cả
            </a>
            <a asp-action="Index" asp-route-status="pending" class="btn btn-light border @(ViewBag.CurrentStatus == "pending" ? "active" : "")">
                Chờ xử lý
            </a>
            <a asp-action="Index" asp-route-status="shipped" class="btn btn-light border @(ViewBag.CurrentStatus == "shipped" ? "active" : "")">
                Đã giao
            </a>
            <a asp-action="Index" asp-route-status="completed" class="btn btn-light border @(ViewBag.CurrentStatus == "completed" ? "active" : "")">
                Hoàn thành
            </a>
        </div>

        <!-- Orders Table -->
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="border-bottom">
                        <tr>
                            <th class="border-0 fw-normal"><small>Mã đơn</small></th>
                            <th class="border-0 fw-normal"><small>Sách</small></th>
                            <th class="border-0 fw-normal"><small>Người mua</small></th>
                            <th class="border-0 fw-normal"><small>SL</small></th>
                            <th class="border-0 fw-normal"><small>Giá</small></th>
                            <th class="border-0 fw-normal"><small>Ngày đặt</small></th>
                            <th class="border-0 fw-normal"><small>Trạng thái</small></th>
                            <th class="border-0 fw-normal"><small>Thao tác</small></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.OrderId</td>
                                <td>
                                    <strong class="fw-normal">@item.Book?.Title</strong><br />
                                    <small class="text-muted">@item.Book?.Author</small>
                                </td>
                                <td>
                                    @item.Order?.Buyer?.FullName<br />
                                    <small class="text-muted">@item.Order?.Buyer?.Email</small>
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.PriceAtPurchase.ToString("N0") đ</td>
                                <td>@item.Order?.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-light text-dark border">Chờ xử lý</span>
                                    }
                                    else if (item.Status == "Shipped")
                                    {
                                        <span class="badge bg-light text-dark border">Đã giao</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-light text-dark border">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-action="MarkAsShipped" asp-route-id="@item.OrderItemId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-dark" onclick="return confirm('Đánh dấu đơn hàng này là đã giao?')">
                                                Đã giao hàng
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == "Shipped")
                                    {
                                        <span class="text-muted"><small>Đã giao: @item.ShippedAt?.ToString("dd/MM/yyyy")</small></span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="text-muted"><small>Hoàn thành</small></span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                @if (ViewBag.CurrentStatus == "all")
                {
                    <p class="mt-3 text-muted">Bạn chưa có đơn hàng nào.</p>
                }
                else
                {
                    <p class="mt-3 text-muted">Không có đơn hàng với trạng thái "@ViewBag.CurrentStatus".</p>
                }
            </div>
        }
    </div>
</div>
