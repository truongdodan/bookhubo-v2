@model BookHubo.Models.Book
@{
    ViewData["Title"] = Model.Title;
    var relatedBooks = ViewBag.RelatedBooks as IEnumerable<BookHubo.Models.Book>;
    var reviews = ViewBag.Reviews as List<BookHubo.Models.Review>;
    var hasMoreReviews = ViewBag.HasMoreReviews ?? false;
}

<div class="mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-light border text-dark">
        ← Quay lại
    </a>
</div>

<!-- Book Details -->
<div class="card border mb-5">
    <div class="card-body p-4">
        <div class="row g-4">
            <!-- Image -->
            <div class="col-md-5">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded shadow">
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                        <i class="bi bi-book text-muted" style="font-size: 8rem;"></i>
                    </div>
                }
            </div>

            <!-- Info -->
            <div class="col-md-7">
                <h3 class="mb-3 fw-normal">@Model.Title</h3>

                <div class="mb-4">
                    <p class="mb-1 text-muted">
                        <small>Tác giả: @Model.Author</small>
                    </p>

                    @if (!string.IsNullOrEmpty(Model.ISBN))
                    {
                        <p class="mb-1 text-muted">
                            <small>ISBN: @Model.ISBN</small>
                        </p>
                    }

                    <p class="mb-1 text-muted">
                        <small>Danh mục:
                        <a asp-action="Category" asp-route-category="@Model.Category" class="text-decoration-none text-dark">@Model.Category</a>
                        </small>
                    </p>

                    <p class="mb-1 text-muted">
                        <small>Tình trạng: @Model.Condition</small>
                    </p>

                    <p class="mb-0 text-muted">
                        <small>Còn lại: @Model.StockQuantity cuốn</small>
                    </p>
                </div>

                <!-- Price -->
                <div class="mb-4">
                    <h4 class="fw-bold">@Model.Price.ToString("N0") đ</h4>
                </div>

                <!-- Seller Info -->
                <div class="mb-4 p-3 bg-light border">
                    <p class="text-muted mb-1"><small>Người bán</small></p>
                    <p class="mb-0">
                        <a asp-controller="Seller" asp-action="PublicProfile" asp-route-id="@Model.SellerId" class="text-decoration-none text-dark fw-bold">
                            @Model.Seller?.FullName
                            @if (Model.Seller?.AverageRating > 0)
                            {
                                <span class="text-warning">
                                    ★ @Model.Seller.AverageRating.ToString("0.0")
                                </span>
                            }
                        </a>
                    </p>
                    @if (Model.Seller?.TotalReviews > 0)
                    {
                        <p class="mb-0 mt-1">
                            <small class="text-muted">
                                <a asp-controller="Seller" asp-action="PublicProfile" asp-route-id="@Model.SellerId" class="text-decoration-none">
                                    Xem hồ sơ (@Model.Seller.TotalReviews đánh giá)
                                </a>
                            </small>
                        </p>
                    }
                </div>

                <!-- Add to Cart Button -->
                @if (Model.StockQuantity > 0)
                {
                    <button type="button" class="btn btn-dark w-100 mb-2" onclick="addToCart(@Model.BookId)">
                        Thêm vào giỏ hàng
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-light border w-100 mb-2" disabled>
                        Hết hàng
                    </button>
                }

                <button type="button" class="btn btn-outline-dark w-100">
                    Mua ngay
                </button>
            </div>
        </div>

        <!-- Description -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <hr class="my-4">
            <div>
                <h6 class="fw-normal mb-3">Mô tả sản phẩm</h6>
                <p class="text-muted" style="white-space: pre-line;">@Model.Description</p>
            </div>
        }

        <!-- Reviews Section -->
        <hr class="my-4">
        <div>
            <h6 class="fw-normal mb-3">
                Đánh giá sản phẩm
                @if (Model.TotalReviews > 0)
                {
                    <span class="text-muted">
                        (@Model.TotalReviews)
                    </span>
                }
            </h6>

            @if (Model.TotalReviews > 0)
            {
                <div class="mb-4 p-3 bg-light border">
                    <div class="d-flex align-items-center">
                        <div class="me-4">
                            <div class="h3 fw-bold text-warning mb-0">@Model.AverageRating.ToString("0.0")</div>
                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= (double)Model.AverageRating)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">☆</span>
                                    }
                                }
                            </div>
                        </div>
                        <div>
                            <p class="mb-0 text-muted"><small>@Model.TotalReviews đánh giá</small></p>
                        </div>
                    </div>
                </div>

                <div class="row" id="reviews-container">
                    @foreach (var review in reviews!)
                    {
                        <div class="col-12 mb-3">
                            <partial name="_ReviewCard" model="review" />
                        </div>
                    }
                </div>

                @if (hasMoreReviews)
                {
                    <div class="text-center mt-3">
                        <button id="load-more-btn" class="btn btn-light border" onclick="loadMoreReviews()">
                            Xem thêm
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    <small>Chưa có đánh giá nào cho sản phẩm này</small>
                </div>
            }
        </div>
    </div>
</div>

<!-- Related Books -->
@if (relatedBooks != null && relatedBooks.Any())
{
    <div class="mb-5">
        <h6 class="fw-normal mb-3 text-muted">Sách liên quan</h6>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-5 g-3">
            @foreach (var book in relatedBooks)
            {
                <div class="col">
                    <a asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none text-dark">
                        <div class="card h-100 border" style="cursor: pointer; transition: box-shadow 0.2s;">
                            @if (!string.IsNullOrEmpty(book.ImagePath))
                            {
                                <img src="@book.ImagePath" class="card-img-top" alt="@book.Title" style="height: 180px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                    <i class="bi bi-book text-secondary" style="font-size: 2.5rem;"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title mb-1 fw-normal small">@book.Title</h6>
                                <p class="card-text mb-2">
                                    <small class="text-muted">@book.Author</small>
                                </p>
                                <p class="fw-bold mb-0 small mt-auto">@book.Price.ToString("N0") đ</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        let currentSkip = 5; // Already loaded 5 reviews
        const bookId = @Model.BookId;

        async function loadMoreReviews() {
            const btn = document.getElementById('load-more-btn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tải...';

            try {
                const response = await fetch(`/Books/LoadMoreReviews?bookId=${bookId}&skip=${currentSkip}&take=5`);
                const reviews = await response.json();

                if (reviews.length > 0) {
                    const container = document.getElementById('reviews-container');

                    reviews.forEach(review => {
                        const reviewHtml = `
                            <div class="col-12 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1">${review.buyerName}</h6>
                                                <small class="text-muted">${review.createdAt}</small>
                                            </div>
                                            <div class="text-warning fs-5">
                                                ${generateStars(review.rating)}
                                            </div>
                                        </div>
                                        ${review.comment ?
                                            `<p class="mb-0">${review.comment}</p>` :
                                            '<p class="mb-0 text-muted fst-italic">Người mua không để lại nhận xét</p>'
                                        }
                                    </div>
                                </div>
                            </div>
                        `;
                        container.insertAdjacentHTML('beforeend', reviewHtml);
                    });

                    currentSkip += reviews.length;

                    // Check if there are more reviews
                    if (currentSkip >= @Model.TotalReviews) {
                        btn.remove();
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = 'Xem thêm';
                    }
                } else {
                    btn.remove();
                }
            } catch (error) {
                console.error('Error loading reviews:', error);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá';
                alert('Có lỗi xảy ra khi tải đánh giá');
            }
        }

        function generateStars(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= rating) {
                    stars += '<span>★</span>';
                } else {
                    stars += '<span class="text-muted">☆</span>';
                }
            }
            return stars;
        }
    </script>
}

