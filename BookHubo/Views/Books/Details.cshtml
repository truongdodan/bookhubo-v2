@model BookHubo.Models.Book
@{
    ViewData["Title"] = Model.Title;
    var relatedBooks = ViewBag.RelatedBooks as IEnumerable<BookHubo.Models.Book>;
    var reviews = ViewBag.Reviews as List<BookHubo.Models.Review>;
    var hasMoreReviews = ViewBag.HasMoreReviews ?? false;
}

<div class="mb-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại trang chủ
    </a>
</div>

<!-- Book Details -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row">
            <!-- Image -->
            <div class="col-md-5">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded shadow">
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                        <i class="bi bi-book text-muted" style="font-size: 8rem;"></i>
                    </div>
                }
            </div>

            <!-- Info -->
            <div class="col-md-7">
                <h2 class="mb-3">@Model.Title</h2>

                <div class="mb-3">
                    <p class="mb-2">
                        <i class="bi bi-person"></i> <strong>Tác giả:</strong> @Model.Author
                    </p>

                    @if (!string.IsNullOrEmpty(Model.ISBN))
                    {
                        <p class="mb-2">
                            <i class="bi bi-upc"></i> <strong>ISBN:</strong> @Model.ISBN
                        </p>
                    }

                    <p class="mb-2">
                        <i class="bi bi-tag"></i> <strong>Danh mục:</strong>
                        <a asp-action="Category" asp-route-category="@Model.Category" class="text-decoration-none">@Model.Category</a>
                    </p>

                    <p class="mb-2">
                        <i class="bi bi-star"></i> <strong>Tình trạng:</strong>
                        <span class="badge bg-info">@Model.Condition</span>
                    </p>

                    <p class="mb-2">
                        <i class="bi bi-box-seam"></i> <strong>Còn lại:</strong> @Model.StockQuantity cuốn
                    </p>
                </div>

                <!-- Price -->
                <div class="mb-4">
                    <h3 class="text-success">@Model.Price.ToString("N0") VNĐ</h3>
                </div>

                <!-- Seller Info -->
                <div class="mb-4 p-3 bg-light rounded">
                    <p class="text-muted mb-1">Bán bởi</p>
                    <p class="fs-5 fw-bold mb-0">
                        <a asp-controller="Seller" asp-action="PublicProfile" asp-route-id="@Model.SellerId" class="text-decoration-none text-dark">
                            @Model.Seller?.FullName
                            @if (Model.Seller?.AverageRating > 0)
                            {
                                <span class="text-warning">
                                    <i class="bi bi-star-fill"></i> @Model.Seller.AverageRating.ToString("0.0")
                                </span>
                            }
                        </a>
                    </p>
                    @if (Model.Seller?.TotalReviews > 0)
                    {
                        <p class="mb-0">
                            <small class="text-muted">
                                <a asp-controller="Seller" asp-action="PublicProfile" asp-route-id="@Model.SellerId" class="text-decoration-none">
                                    Xem hồ sơ người bán (@Model.Seller.TotalReviews đánh giá)
                                </a>
                            </small>
                        </p>
                    }
                </div>

                <!-- Add to Cart Button -->
                @if (Model.StockQuantity > 0)
                {
                    <button type="button" class="btn btn-success btn-lg w-100 mb-2" onclick="addToCart(@Model.BookId)">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary btn-lg w-100 mb-2" disabled>
                        <i class="bi bi-x-circle"></i> Hết hàng
                    </button>
                }

                <button type="button" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-cash"></i> Mua ngay
                </button>
            </div>
        </div>

        <!-- Description -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <hr class="my-4">
            <div>
                <h4>Mô tả sản phẩm</h4>
                <p class="text-muted" style="white-space: pre-line;">@Model.Description</p>
            </div>
        }

        <!-- Reviews Section -->
        <hr class="my-4">
        <div>
            <h4 class="mb-3">
                <i class="bi bi-star"></i> Đánh giá sản phẩm
                @if (Model.TotalReviews > 0)
                {
                    <span class="fs-6 text-muted">
                        (@Model.TotalReviews đánh giá)
                    </span>
                }
            </h4>

            @if (Model.TotalReviews > 0)
            {
                <div class="mb-4 p-3 bg-light rounded">
                    <div class="d-flex align-items-center">
                        <div class="me-4">
                            <div class="display-4 fw-bold text-warning">@Model.AverageRating.ToString("0.0")</div>
                            <div class="text-warning fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= (double)Model.AverageRating)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">☆</span>
                                    }
                                }
                            </div>
                        </div>
                        <div>
                            <p class="mb-0 text-muted">Dựa trên @Model.TotalReviews đánh giá</p>
                        </div>
                    </div>
                </div>

                <div class="row" id="reviews-container">
                    @foreach (var review in reviews!)
                    {
                        <div class="col-12 mb-3">
                            <partial name="_ReviewCard" model="review" />
                        </div>
                    }
                </div>

                @if (hasMoreReviews)
                {
                    <div class="text-center mt-3">
                        <button id="load-more-btn" class="btn btn-outline-primary" onclick="loadMoreReviews()">
                            <i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-chat-left-text"></i> Chưa có đánh giá nào cho sản phẩm này
                </div>
            }
        </div>
    </div>
</div>

<!-- Related Books -->
@if (relatedBooks != null && relatedBooks.Any())
{
    <div class="mb-4">
        <h3 class="mb-3">Sách liên quan</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var book in relatedBooks)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(book.ImagePath))
                        {
                            <img src="@book.ImagePath" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-book text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h6 class="card-title">@book.Title</h6>
                            <p class="card-text">
                                <small class="text-muted">@book.Author</small><br>
                                <span class="text-success fw-bold">@book.Price.ToString("N0") VNĐ</span>
                            </p>
                            <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-primary w-100">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        let currentSkip = 5; // Already loaded 5 reviews
        const bookId = @Model.BookId;

        async function loadMoreReviews() {
            const btn = document.getElementById('load-more-btn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tải...';

            try {
                const response = await fetch(`/Books/LoadMoreReviews?bookId=${bookId}&skip=${currentSkip}&take=5`);
                const reviews = await response.json();

                if (reviews.length > 0) {
                    const container = document.getElementById('reviews-container');

                    reviews.forEach(review => {
                        const reviewHtml = `
                            <div class="col-12 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1">${review.buyerName}</h6>
                                                <small class="text-muted">${review.createdAt}</small>
                                            </div>
                                            <div class="text-warning fs-5">
                                                ${generateStars(review.rating)}
                                            </div>
                                        </div>
                                        ${review.comment ?
                                            `<p class="mb-0">${review.comment}</p>` :
                                            '<p class="mb-0 text-muted fst-italic">Người mua không để lại nhận xét</p>'
                                        }
                                    </div>
                                </div>
                            </div>
                        `;
                        container.insertAdjacentHTML('beforeend', reviewHtml);
                    });

                    currentSkip += reviews.length;

                    // Check if there are more reviews
                    if (currentSkip >= @Model.TotalReviews) {
                        btn.remove();
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá';
                    }
                } else {
                    btn.remove();
                }
            } catch (error) {
                console.error('Error loading reviews:', error);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Xem thêm đánh giá';
                alert('Có lỗi xảy ra khi tải đánh giá');
            }
        }

        function generateStars(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= rating) {
                    stars += '<span>★</span>';
                } else {
                    stars += '<span class="text-muted">☆</span>';
                }
            }
            return stars;
        }
    </script>
}

