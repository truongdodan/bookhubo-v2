@model IEnumerable<BookHubo.Models.Book>
@{
    ViewData["Title"] = "Sách của tôi";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Sách của tôi</h2>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Đăng sách mới
            </a>
        </div>

        <!-- Quick Stats -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h5>Đang bán</h5>
                        <h2>@ViewBag.TotalActive</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-secondary text-white">
                    <div class="card-body">
                        <h5>Đã bán/Ẩn</h5>
                        <h2>@ViewBag.TotalSold</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter -->
        <div class="btn-group mb-3" role="group">
            <a asp-action="Index" asp-route-filter="all" class="btn btn-outline-primary @(ViewBag.CurrentFilter == "all" ? "active" : "")">
                Tất cả
            </a>
            <a asp-action="Index" asp-route-filter="active" class="btn btn-outline-success @(ViewBag.CurrentFilter == "active" ? "active" : "")">
                Đang bán
            </a>
            <a asp-action="Index" asp-route-filter="sold" class="btn btn-outline-secondary @(ViewBag.CurrentFilter == "sold" ? "active" : "")">
                Đã bán/Ẩn
            </a>
        </div>

        <!-- Books Grid -->
        @if (Model.Any())
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var book in Model)
                {
                    <div class="col">
                        <div class="card h-100 @(!book.IsActive ? "opacity-75" : "")">
                            @if (!string.IsNullOrEmpty(book.ImagePath))
                            {
                                <img src="@book.ImagePath" class="card-img-top" alt="@book.Title" style="height: 250px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                    <span class="text-muted">Không có ảnh</span>
                                </div>
                            }
                            <div class="card-body">
                                <h5 class="card-title">@book.Title</h5>
                                <p class="card-text">
                                    <strong>Tác giả:</strong> @book.Author<br />
                                    <strong>Tình trạng:</strong> @book.Condition<br />
                                    <strong>Giá:</strong> @book.Price.ToString("N0") VNĐ<br />
                                    <strong>Số lượng:</strong> @book.StockQuantity<br />
                                    @if (!book.IsActive)
                                    {
                                        <span class="badge bg-secondary">Đã ẩn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đang bán</span>
                                    }
                                </p>
                            </div>
                            <div class="card-footer">
                                <div class="btn-group w-100" role="group">
                                    <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@book.BookId)">Xóa</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Bạn chưa có sách nào. <a asp-action="Create">Đăng sách đầu tiên!</a>
            </div>
        }
    </div>
</div>

<!-- Delete Form (Hidden) -->
<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function confirmDelete(bookId) {
            if (confirm('Bạn có chắc muốn xóa sách này?')) {
                var form = document.getElementById('deleteForm');
                form.action = '/Books/Delete/' + bookId;
                form.submit();
            }
        }
    </script>
}
