@model IEnumerable<BookHubo.Models.Book>
@{
    ViewData["Title"] = "Sách của tôi";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-normal">Sách của tôi</h4>
            <a asp-action="Create" class="btn btn-dark">
                Đăng sách mới
            </a>
        </div>

        <!-- Quick Stats -->
        <div class="row mb-4 g-3">
            <div class="col-md-6">
                <div class="card border">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0 fw-bold">@ViewBag.TotalActive</h4>
                        <p class="text-muted mb-0 small">Đang bán</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-0 fw-bold">@ViewBag.TotalSold</h4>
                        <p class="text-muted mb-0 small">Đã bán/Ẩn</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter -->
        <div class="btn-group mb-4" role="group">
            <a asp-action="Index" asp-route-filter="all" class="btn btn-light border @(ViewBag.CurrentFilter == "all" ? "active" : "")">
                Tất cả
            </a>
            <a asp-action="Index" asp-route-filter="active" class="btn btn-light border @(ViewBag.CurrentFilter == "active" ? "active" : "")">
                Đang bán
            </a>
            <a asp-action="Index" asp-route-filter="sold" class="btn btn-light border @(ViewBag.CurrentFilter == "sold" ? "active" : "")">
                Đã bán/Ẩn
            </a>
        </div>

        <!-- Books Grid -->
        @if (Model.Any())
        {
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var book in Model)
                {
                    <div class="col">
                        <div class="card h-100 border @(!book.IsActive ? "opacity-75" : "")">
                            @if (!string.IsNullOrEmpty(book.ImagePath))
                            {
                                <img src="@book.ImagePath" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="bi bi-book text-secondary" style="font-size: 3rem;"></i>
                                </div>
                            }
                            <div class="card-body p-3">
                                <h6 class="card-title fw-normal mb-2">@book.Title</h6>
                                <p class="card-text small">
                                    <span class="text-muted">@book.Author</span><br />
                                    <span class="text-muted">@book.Condition</span><br />
                                    <span class="fw-bold">@book.Price.ToString("N0") đ</span><br />
                                    <span class="text-muted">Còn: @book.StockQuantity</span><br />
                                    @if (!book.IsActive)
                                    {
                                        <span class="badge bg-dark mt-1">Đã ẩn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border mt-1">Đang bán</span>
                                    }
                                </p>
                            </div>
                            <div class="card-footer bg-white border-top">
                                <div class="btn-group w-100" role="group">
                                    <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-light border">Sửa</a>
                                    <button type="button" class="btn btn-sm btn-light border" onclick="confirmDelete(@book.BookId)">Xóa</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">Bạn chưa có sách nào. <a asp-action="Create" class="text-dark">Đăng sách đầu tiên!</a></p>
            </div>
        }
    </div>
</div>

<!-- Delete Form (Hidden) -->
<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function confirmDelete(bookId) {
            if (confirm('Bạn có chắc muốn xóa sách này?')) {
                var form = document.getElementById('deleteForm');
                form.action = '/Books/Delete/' + bookId;
                form.submit();
            }
        }
    </script>
}
