@model BookHubo.Models.StatsViewModel
@{
    ViewData["Title"] = "Thống kê bán hàng";
}

<div class="row">
    <div class="col-md-12">
        <h4 class="mb-4 fw-normal">Thống kê bán hàng của tôi</h4>

        <div class="row g-3 mb-5">
            <!-- Total Active Listings -->
            <div class="col-md-6 col-lg-3">
                <div class="card border">
                    <div class="card-body text-center py-4">
                        <h4 class="mb-0 fw-bold">@Model.TotalActiveListings</h4>
                        <p class="text-muted mb-0 small">Đang bán</p>
                    </div>
                </div>
            </div>

            <!-- Total Sold -->
            <div class="col-md-6 col-lg-3">
                <div class="card border">
                    <div class="card-body text-center py-4">
                        <h4 class="mb-0 fw-bold">@Model.TotalSold</h4>
                        <p class="text-muted mb-0 small">Đã bán</p>
                    </div>
                </div>
            </div>

            <!-- Total Revenue -->
            <div class="col-md-6 col-lg-3">
                <div class="card border">
                    <div class="card-body text-center py-4">
                        <h4 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("N0") đ</h4>
                        <p class="text-muted mb-0 small">Tổng doanh thu</p>
                    </div>
                </div>
            </div>

            <!-- Average Rating -->
            <div class="col-md-6 col-lg-3">
                <div class="card border">
                    <div class="card-body text-center py-4">
                        <h4 class="mb-0 fw-bold">@Model.AverageRating.ToString("0.0")</h4>
                        <p class="text-muted mb-0 small">Đánh giá TB (@Model.TotalReviews)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="card border">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0 fw-normal">Thông tin chi tiết</h6>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-2"><small><span class="fw-normal">Sách đang bán:</span> @Model.TotalActiveListings cuốn</small></p>
                        <p class="mb-2"><small><span class="fw-normal">Tổng số sách đã bán:</span> @Model.TotalSold cuốn</small></p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2"><small><span class="fw-normal">Tổng doanh thu:</span> @Model.TotalRevenue.ToString("N0") đ</small></p>
                        <p class="mb-2"><small><span class="fw-normal">Đánh giá trung bình:</span> @Model.AverageRating.ToString("0.0")/5.0 (@Model.TotalReviews lượt)</small></p>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Books" asp-action="Index" class="btn btn-dark me-2">Quản lý sách của tôi</a>
                    <a asp-controller="Sales" asp-action="Index" class="btn btn-outline-dark">Quản lý đơn hàng</a>
                </div>
            </div>
        </div>
    </div>
</div>
