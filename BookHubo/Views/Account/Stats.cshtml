@model BookHubo.Models.StatsViewModel
@{
    ViewData["Title"] = "Thống kê bán hàng";
}

<div class="row">
    <div class="col-md-12">
        <h2 class="mb-4">Thống kê bán hàng của tôi</h2>

        <div class="row g-4">
            <!-- Total Active Listings -->
            <div class="col-md-6 col-lg-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Đang bán</h6>
                                <h2 class="card-title mb-0">@Model.TotalActiveListings</h2>
                            </div>
                            <div>
                                <i class="bi bi-book" style="font-size: 3rem; opacity: 0.5;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Sold -->
            <div class="col-md-6 col-lg-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Đã bán</h6>
                                <h2 class="card-title mb-0">@Model.TotalSold</h2>
                            </div>
                            <div>
                                <i class="bi bi-check-circle" style="font-size: 3rem; opacity: 0.5;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Revenue -->
            <div class="col-md-6 col-lg-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Tổng doanh thu</h6>
                                <h2 class="card-title mb-0">@Model.TotalRevenue.ToString("N0")</h2>
                                <small>VNĐ</small>
                            </div>
                            <div>
                                <i class="bi bi-cash-stack" style="font-size: 3rem; opacity: 0.5;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Average Rating -->
            <div class="col-md-6 col-lg-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-subtitle mb-2">Đánh giá TB</h6>
                                <h2 class="card-title mb-0">@Model.AverageRating.ToString("0.0")</h2>
                                <small>(@Model.TotalReviews đánh giá)</small>
                            </div>
                            <div>
                                <i class="bi bi-star-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title">Thông tin chi tiết</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Sách đang bán:</strong> @Model.TotalActiveListings cuốn</p>
                        <p><strong>Tổng số sách đã bán:</strong> @Model.TotalSold cuốn</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Tổng doanh thu:</strong> @Model.TotalRevenue.ToString("N0") VNĐ</p>
                        <p><strong>Đánh giá trung bình:</strong> @Model.AverageRating.ToString("0.0")/5.0 (@Model.TotalReviews lượt đánh giá)</p>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Quản lý sách của tôi</a>
                    <a asp-controller="Sales" asp-action="Index" class="btn btn-success">Quản lý đơn hàng</a>
                </div>
            </div>
        </div>
    </div>
</div>
